# Copier vers .env.local — ne jamais committer de secrets.

# development | test | production
NEXT_PUBLIC_APP_ENV=development

# URL publique du frontend (SEO, redirections, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL de l'API backend. Laisser vide pour activer les mocks locaux.
# Exemple : https://api.example.com
NEXT_PUBLIC_API_BASE_URL=
