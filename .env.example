# Copier vers .env.local — ne jamais committer de secrets.

# development | test | production
NEXT_PUBLIC_APP_ENV=development

# URL publique du frontend (SEO, redirections, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL de l'API backend. Laisser vide pour activer les mocks locaux.
# Exemple : https://api.example.com
NEXT_PUBLIC_API_BASE_URL=

# Back Office (BFF local). Obligatoire en production.
# ADMIN_SESSION_SECRET=
# Mots de passe des comptes seed (dev uniquement, jamais en production automatique)
# ADMIN_BOOTSTRAP_PASSWORD=TdevAdmin2026!
# STAFF_BOOTSTRAP_PASSWORD=TdevStaff2026!
